<icecast>
    <!-- Signal 0 Radio — Icecast2 Configuration -->

    <location>The Void</location>
    <admin>admin@promptband.ai</admin>

    <limits>
        <clients>100</clients>
        <sources>4</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <!-- Source password (used by Liquidsoap to connect) -->
        <source-password>s1gnal0-src-2026</source-password>
        <!-- Relay password -->
        <relay-password>s1gnal0-src-2026</relay-password>
        <!-- Admin interface password -->
        <admin-user>admin</admin-user>
        <admin-password>s1gnal0-adm1n-2026</admin-password>
    </authentication>

    <hostname>roanokecontrols.com</hostname>

    <listen-socket>
        <port>8000</port>
    </listen-socket>

    <http-headers>
        <header name="Access-Control-Allow-Origin" value="*" />
    </http-headers>

    <mount type="normal">
        <mount-name>/signal-zero</mount-name>
        <stream-name>Signal 0 Radio</stream-name>
        <stream-description>The frequency beneath all frequencies. Broadcasting from nowhere. Received everywhere.</stream-description>
        <stream-url>https://promptband.ai</stream-url>
        <genre>Rock</genre>
        <bitrate>128</bitrate>
        <type>audio/mpeg</type>
        <subtype>mp3</subtype>
        <max-listeners>32</max-listeners>
        <public>1</public>
    </mount>

    <fileserve>1</fileserve>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>3</loglevel>
        <logsize>10000</logsize>
    </logging>

    <security>
        <chroot>0</chroot>
    </security>
</icecast>
